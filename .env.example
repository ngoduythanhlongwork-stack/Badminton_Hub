# Go API reads process environment (no automatic .env loading).
HTTP_ADDR=127.0.0.1:5080
DATABASE_URL=postgres://badminton_hub:local_only_change_me@localhost:55432/badminton_hub?sslmode=disable
# Integration tests only. The role must be allowed to CREATE DATABASE.
TEST_DATABASE_URL=postgres://badminton_hub:local_only_change_me@localhost:55432/postgres?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Local development only; production must inject an independent random secret.
IDENTITY_TOKEN_SECRET=local_only_change_me_identity_token_secret_32_bytes
DEPENDENCY_TIMEOUT=2s
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
